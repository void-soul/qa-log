{
  "name": "qa-log-browser",
  "displayName": "QA Log",
  "description": "在侧边栏浏览项目根目录 qa.db：QA 记录 + CodeBuddy Agent 会话日志",
  "version": "0.2.2",
  "icon": "media/icon.png",
  "publisher": "qa-log",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/void-soul/qa-log.git"
  },
  "homepage": "https://github.com/void-soul/qa-log#readme",
  "bugs": {
    "url": "https://github.com/void-soul/qa-log/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "扩展会在工作区中查找并执行 scripts/qa_query.py，并读写项目内的 qa.db。"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "需要真实的本地文件系统才能定位 qa.db。"
    }
  },
  "activationEvents": [
    "onView:qaLog.qaView",
    "onView:qaLog.logView",
    "onView:qaLog.healthView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qaLogQaContainer",
          "title": "QA 记录",
          "icon": "media/qa.svg"
        },
        {
          "id": "qaLogLogContainer",
          "title": "Agent 日志",
          "icon": "media/log.svg"
        },
        {
          "id": "qaLogHealthContainer",
          "title": "记忆健康",
          "icon": "media/health.svg"
        }
      ]
    },
    "views": {
      "qaLogQaContainer": [
        {
          "id": "qaLog.qaView",
          "name": "QA 记录",
          "type": "webview"
        }
      ],
      "qaLogLogContainer": [
        {
          "id": "qaLog.logView",
          "name": "Agent 日志",
          "type": "webview"
        }
      ],
      "qaLogHealthContainer": [
        {
          "id": "qaLog.healthView",
          "name": "记忆健康",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "qaLog.refresh",
        "title": "QA Log: 刷新",
        "icon": "$(refresh)"
      },
      {
        "command": "qaLog.openDb",
        "title": "QA Log: 打开 qa.db 所在目录"
      },
      {
        "command": "qaLog.setupHooks",
        "title": "QA Log: 启用/停用 Agent 会话自动记录 (hooks)"
      },
      {
        "command": "qaLog.openHealthReport",
        "title": "QA Log: 在终端打开完整健康报告"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "qaLog.refresh",
          "when": "view == qaLog.qaView || view == qaLog.logView || view == qaLog.healthView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "QA Log",
      "properties": {
        "qaLog.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python 可执行文件（用于读取 qa.db）"
        },
        "qaLog.dbPath": {
          "type": "string",
          "default": "",
          "description": "qa.db 路径。留空则自动使用当前工作区根目录下的 qa.db"
        },
        "qaLog.scriptPath": {
          "type": "string",
          "default": "",
          "description": "qa_query.py 路径。留空则自动在若干常见位置查找"
        }
      }
    }
  },
  "scripts": {
    "sync-vendor": "node sync-vendor.js",
    "prepackage": "node sync-vendor.js",
    "test": "node --test \"tests/*.test.js\"",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  }
}
